---
// Portrait in the About header. Until the photo is supplied it renders a decorative framed placeholder that makes
// no image request; once `about.portrait.photo` names a file in src/assets/portrait, Astro optimizes it at build time.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { isPlaceholder, type Portrait } from '../content/portfolio';
import Placeholder from './Placeholder.astro';

interface Props {
  portrait: Portrait;
}

const { portrait } = Astro.props;

const photos = import.meta.glob<ImageMetadata>('/src/assets/portrait/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});

let photo: ImageMetadata | undefined;
if (!isPlaceholder(portrait.photo)) {
  const key = `/${portrait.photo.replace(/^\/+/, '')}`;
  photo = photos[key];
  if (!photo) throw new Error(`about.portrait.photo: ${portrait.photo} was not found in src/assets/portrait`);
}

// Rendered size at 1440; narrow screens scale it down in CSS. Both keep the 4:5 ratio.
const width = 176;
const height = 220;
---

<div class="portrait">
  <div class="frame-wrap">
    <span class="corner corner-tl" aria-hidden="true"></span>
    <span class="corner corner-tr" aria-hidden="true"></span>
    <span class="corner corner-bl" aria-hidden="true"></span>
    <span class="corner corner-br" aria-hidden="true"></span>
    {
      photo ? (
        <div class="frame">
          <Picture
            src={photo}
            alt={portrait.alt}
            width={width}
            height={height}
            densities={[1, 2]}
            formats={['avif', 'webp']}
            fit="cover"
            position="center"
            loading="lazy"
            decoding="async"
            class="photo"
          />
          <span class="scanlines" aria-hidden="true" />
        </div>
      ) : (
        <Placeholder as="div" decorative class="frame frame-placeholder">
          <span class="initials">{portrait.placeholderInitials}</span>
          <span class="placeholder-caption">{portrait.placeholderCaption}</span>
        </Placeholder>
      )
    }
  </div>
  <p class="caption" aria-hidden="true">{portrait.caption}</p>
</div>

<style>
  .portrait {
    --corner-color: var(--accent-cyan);

    position: relative;
    flex: none;
    width: 176px;
  }

  .portrait:has(.frame-placeholder) {
    --corner-color: var(--text-muted);
  }

  .frame-wrap {
    position: relative;
  }

  .frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line-hairline);
    border-radius: var(--radius-control);
    background: var(--surface-panel);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .scanlines {
    position: absolute;
    inset: 0;
    opacity: 0.07;
    background: repeating-linear-gradient(0deg, #fff 0 1px, transparent 1px 3px);
    pointer-events: none;
  }

  .frame-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 1px dashed var(--border-control);
    padding: var(--space-3);
    text-align: center;
  }

  .initials {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 40px;
    font-weight: var(--weight-mono-strong);
    line-height: 1;
  }

  .placeholder-caption,
  .caption {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .caption {
    margin: var(--space-3) 0 0;
    letter-spacing: var(--tracking-label);
  }

  /* HUD target-lock brackets, 6 px outside the frame. */
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--corner-color);
  }

  .corner-tl {
    top: -6px;
    left: -6px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .corner-tr {
    top: -6px;
    right: -6px;
    border-top-width: 2px;
    border-right-width: 2px;
  }

  .corner-bl {
    bottom: -6px;
    left: -6px;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .corner-br {
    right: -6px;
    bottom: -6px;
    border-right-width: 2px;
    border-bottom-width: 2px;
  }

  @media (max-width: 820px) {
    .portrait {
      width: 144px;
    }
  }
</style>
