---
// The home page header: section links in a fixed pill row, and a Menu disclosure on narrow screens.
// Given `home` (the home page URL), it is the header of another page instead: a home link and the same section links
// pointing at the home page, in a static row that wraps on narrow screens and needs no script.
import { caseStudyUi } from '../content/case-studies';
import { portfolio } from '../content/portfolio';
import NavMenu from './NavMenu.astro';

interface Props {
  home?: string;
}

const { home } = Astro.props;
const { ui, sections } = portfolio;
const links = sections.flatMap((section) =>
  section.navLabel ? [{ href: `${home ?? ''}#${section.id}`, label: section.navLabel }] : [],
);
---

<header class:list={['site-header', { 'site-header-page': home !== undefined }]}>
  {
    home !== undefined && (
      <a class="home-link" href={home} aria-label={caseStudyUi.homeLinkLabel}>
        <span class="home-dot" aria-hidden="true" />
        {caseStudyUi.homeLink}
      </a>
    )
  }
  <nav class="site-nav" aria-label={ui.navLabel} data-site-nav>
    {
      home === undefined && (
        <button type="button" class="menu-button" aria-expanded="false" aria-controls="site-nav-list" data-menu-button>
          {ui.menuButton}
        </button>
      )
    }
    <ul class="nav-list" id="site-nav-list">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
{home === undefined && <NavMenu />}

<style>
  .site-header {
    position: fixed;
    top: 12px;
    right: var(--gutter);
    z-index: 3;
  }

  .nav-list {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a,
  .menu-button {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color var(--duration-base),
      border-color var(--duration-base),
      background-color var(--duration-base);
  }

  .nav-list a:hover,
  .nav-list a[aria-current='location'] {
    border-color: var(--border-control);
    background: var(--surface-panel);
    color: var(--text-primary);
  }

  .menu-button {
    display: none;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border-color: var(--border-control);
    background: var(--surface-panel-mobile);
    color: var(--text-primary);
    font-family: var(--font-mono);
    cursor: pointer;
  }

  @media (max-width: 820px) {
    /* Without scripts the list stays in the page flow and wraps under the status readout. */
    .site-header {
      position: absolute;
      top: 48px;
      left: var(--gutter);
    }

    .nav-list {
      flex-wrap: wrap;
    }

    .nav-list a {
      min-height: 44px;
    }

    :global(.js) .site-header {
      position: fixed;
      top: 8px;
      left: auto;
    }

    :global(.js) .menu-button {
      display: inline-flex;
    }

    :global(.js) .nav-list {
      display: none;
    }

    :global(.js) .menu-button[aria-expanded='true'] + .nav-list {
      position: fixed;
      top: 64px;
      right: var(--gutter);
      left: var(--gutter);
      display: grid;
      gap: var(--space-1);
      padding: var(--space-2);
      border: 1px solid var(--border-control);
      border-radius: var(--radius-control);
      /* Backed by the page colour: page content must not show through the open menu. */
      background: linear-gradient(var(--surface-panel-mobile), var(--surface-panel-mobile)), var(--color-bg);
      box-shadow: 0 24px 48px rgb(4 6 13 / 0.6);
    }

    :global(.js) .menu-button[aria-expanded='true'] + .nav-list a {
      display: flex;
      min-height: 48px;
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-chip);
      color: var(--text-primary);
      font-size: var(--text-label);
    }
  }

  /* Header of a page other than home: in the page flow, home link on the left and the section links on the right. */
  .site-header-page {
    position: relative;
    top: auto;
    right: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--gutter) 0;
  }

  .home-link {
    display: inline-flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 44px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
  }

  .home-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .home-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
  }

  .site-header-page .nav-list {
    flex-wrap: wrap;
  }

  .site-header-page .nav-list a {
    min-height: 44px;
  }

  @media (max-width: 820px) {
    .site-header-page {
      flex-direction: column;
      align-items: flex-start;
      position: relative;
      top: auto;
      left: auto;
    }

    /* The first link's label lines up with the home link above it. */
    .site-header-page .nav-list {
      margin-left: calc(-1 * var(--space-3));
    }
  }
</style>
