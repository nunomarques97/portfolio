---
import { portfolio, type Portfolio } from '../content/portfolio';

interface Props {
  skills?: Portfolio['skills'];
}

const { skills = portfolio.skills } = Astro.props;
---

<section id="skills" class="skills" aria-labelledby="skills-heading">
  <div class="section-inner">
    <p class="eyebrow">{skills.eyebrow}</p>
    <h2 id="skills-heading">{skills.heading}</h2>
    <div class="skill-grid">
      {
        skills.groups.map((group) => (
          <div class="panel skill-group">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .skill-group {
    min-width: 0;
    padding: 22px;
  }

  h3 {
    margin: 0 0 var(--space-3);
    color: var(--text-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-regular);
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    max-width: 100%;
    padding: 6px 11px;
    border: 1px solid var(--chip-line);
    border-radius: var(--radius-chip);
    background: var(--chip-fill);
    color: var(--text-primary);
    font-size: var(--text-chip);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  @media (max-width: 820px) {
    .skill-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
